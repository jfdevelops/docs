{
  "name": "@jfdevelops/docs",
  "version": "0.0.0",
  "description": "Generate and check versioned library docs: navigation, docs.json, and a TypeDoc API reference",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfdevelops/docs.git"
  },
  "bin": {
    "jfdevelops-docs": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test",
    "check": "pnpm test && pnpm pack --dry-run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm check && changeset publish"
  },
  "dependencies": {
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
