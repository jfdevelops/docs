{
  "name": "@jfdevelops/docs",
  "version": "0.2.0",
  "description": "Generate and check versioned library docs: navigation, docs.json, and a TypeDoc API reference",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfdevelops/docs.git"
  },
  "bin": {
    "jfdevelops-docs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm pack --dry-run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm check && changeset publish"
  },
  "dependencies": {
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
